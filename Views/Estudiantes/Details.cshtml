@model GestionAcademica.Models.Estudiante

@{
    ViewData["Title"] = "Detalles del Estudiante";
}

<h1>Detalles del Estudiante</h1>

<div>
    <dl class="row">
        <dt class="col-sm-3">Nombre</dt>
        <dd class="col-sm-9">@Model.Nombre</dd>

        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>

        <dt class="col-sm-3">Fecha de Nacimiento</dt>
        <dd class="col-sm-9">@(Model.FechaNacimiento.HasValue ? Model.FechaNacimiento.Value.ToShortDateString() : "-")</dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.EstudianteId" class="btn btn-warning">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>