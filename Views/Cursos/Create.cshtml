@model GestionAcademica.Models.Curso

@{
    ViewData["Title"] = "Nuevo Curso";
}

<h1>Nuevo Curso</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Nombre" class="control-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Creditos" class="control-label"></label>
                <input asp-for="Creditos" class="form-control" />
                <span asp-validation-for="Creditos" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ProfesorId" class="control-label">Profesor</label>
                <select asp-for="ProfesorId" class="form-control" asp-items="ViewBag.ProfesorId">
                    <option value="">-- Selecciona un profesor --</option>
                </select>
                <span asp-validation-for="ProfesorId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Crear" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}