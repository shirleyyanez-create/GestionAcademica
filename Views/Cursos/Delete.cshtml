@model GestionAcademica.Models.Curso

@{
    ViewData["Title"] = "Eliminar Curso";
}

<h1>Eliminar Curso</h1>

<h3>¿Está seguro de que desea eliminar este curso?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-3">Nombre</dt>
        <dd class="col-sm-9">@Model.Nombre</dd>

        <dt class="col-sm-3">Créditos</dt>
        <dd class="col-sm-9">@Model.Creditos</dd>

        <dt class="col-sm-3">Profesor</dt>
        <dd class="col-sm-9">@Model.Profesor?.Nombre</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="CursoId" />
        <input type="submit" value="Eliminar" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>