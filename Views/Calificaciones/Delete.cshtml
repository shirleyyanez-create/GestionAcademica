@model GestionAcademica.Models.Calificacion

@{
    ViewData["Title"] = "Eliminar Calificación";
}

<h1>Eliminar Calificación</h1>

<h3>¿Está seguro de que desea eliminar esta calificación?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-3">Estudiante</dt>
        <dd class="col-sm-9">@Model.Matricula?.Estudiante?.Nombre</dd>

        <dt class="col-sm-3">Curso</dt>
        <dd class="col-sm-9">@Model.Matricula?.Curso?.Nombre</dd>

        <dt class="col-sm-3">Periodo</dt>
        <dd class="col-sm-9">@Model.Periodo</dd>

        <dt class="col-sm-3">Nota</dt>
        <dd class="col-sm-9">@Model.Nota</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="CalificacionId" />
        <input type="submit" value="Eliminar" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>