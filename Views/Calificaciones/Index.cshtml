@model IEnumerable<GestionAcademica.Models.Calificacion>

@{
    ViewData["Title"] = "Calificaciones";
}

<h1>Calificaciones</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Nueva Calificación</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Estudiante</th>
            <th>Curso</th>
            <th>Periodo</th>
            <th>Nota</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Matricula?.Estudiante?.Nombre</td>
            <td>@item.Matricula?.Curso?.Nombre</td>
            <td>@item.Periodo</td>
            <td>@item.Nota</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.CalificacionId" class="btn btn-info btn-sm">Detalles</a>
                <a asp-action="Edit" asp-route-id="@item.CalificacionId" class="btn btn-warning btn-sm">Editar</a>
                <a asp-action="Delete" asp-route-id="@item.CalificacionId" class="btn btn-danger btn-sm">Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>