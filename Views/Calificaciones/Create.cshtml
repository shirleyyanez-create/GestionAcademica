@model GestionAcademica.Models.Calificacion

@{
    ViewData["Title"] = "Nueva Calificación";
}

<h1>Nueva Calificación</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="MatriculaId" class="control-label">Matrícula</label>
                <select asp-for="MatriculaId" class="form-control" asp-items="ViewBag.MatriculaId">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="MatriculaId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Periodo" class="control-label"></label>
                <input asp-for="Periodo" class="form-control" />
                <span asp-validation-for="Periodo" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Nota" class="control-label"></label>
                <input asp-for="Nota" class="form-control" />
                <span asp-validation-for="Nota" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Guardar" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}