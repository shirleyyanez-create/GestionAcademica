@model IEnumerable<GestionAcademica.Models.Matricula>

@{
    ViewData["Title"] = "Matrículas";
}

<h1>Matrículas</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Nueva Matrícula</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Estudiante</th>
            <th>Curso</th>
            <th>Fecha Matrícula</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.Estudiante?.Nombre</td>
            <td>@item.Curso?.Nombre</td>
            <td>@item.FechaMatricula.ToShortDateString()</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.MatriculaId" class="btn btn-sm btn-info">Detalles</a>
                <a asp-action="Edit" asp-route-id="@item.MatriculaId" class="btn btn-sm btn-warning">Editar</a>
                <a asp-action="Delete" asp-route-id="@item.MatriculaId" class="btn btn-sm btn-danger">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>