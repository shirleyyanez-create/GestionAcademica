@model GestionAcademica.Models.Profesor

@{
    ViewData["Title"] = "Detalles del Profesor";
}

<h1>Detalles del Profesor</h1>

<div>
    <dl class="row">
        <dt class="col-sm-3">Nombre</dt>
        <dd class="col-sm-9">@Model.Nombre</dd>

        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>

        <dt class="col-sm-3">Especialidad</dt>
        <dd class="col-sm-9">@Model.Especialidad</dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.ProfesorId" class="btn btn-warning">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>